{
  "schemaVersion": 1,
  "id": "wigo",
  "version": "${version}",
  "name": "What is going on (WIGO)",
  "accessWidener": "wigo.accesswidener", "icon": "assets/wigo/icon.png",
  "description": "Live nearby menu state rendered with the observer's local Minecraft resources.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.wigo.platform.fabric.WigoFabric"
    ],
    "client": [
      "dev.wigo.platform.fabric.WigoFabricClient"
    ]
  },
  "mixins": [
    "wigo.mixins.json",
    {
      "config": "wigo.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "=1.21.9",
    "java": ">=21",
    "fabric-api": ">=0.134.1"
  },
  "license": "GPL-3.0-only"
}
